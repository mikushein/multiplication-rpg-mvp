# MongoDB Connection String
# For local development: mongodb://localhost:27017/multiplication-rpg
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/multiplication-rpg
MONGO_URI=mongodb://localhost:27017/multiplication-rpg

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# Teacher dashboard password
TEACHER_PASSWORD=teacher123

# Optional in production when frontend is on a different domain
# Example: https://your-site.netlify.app
# For multiple origins, separate with commas
# Local development examples: http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
